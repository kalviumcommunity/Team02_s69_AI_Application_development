# Copy this file to .env and fill in your values. Never commit .env.

# Embeddings: builds and searches the vector index. Everyone on the team
# should use the SAME embedding settings — a query embedded with a
# different model than the one that built the index will not retrieve
# correctly. Default is Google's Gemini embedding model, which has a free
# tier: get a key from https://aistudio.google.com/
EMBEDDING_API_KEY=your-gemini-api-key-here
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=gemini-embedding-001

# Chat LLM: generates the final answer text from retrieved context only.
# Unlike embeddings, this does NOT need to match across teammates — use
# any OpenAI-compatible provider, model and key you have. Examples:
#   OpenAI:      CHAT_BASE_URL=https://api.openai.com/v1
#   Groq:        CHAT_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter:  CHAT_BASE_URL=https://openrouter.ai/api/v1
CHAT_API_KEY=your-chat-api-key-here
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini

# Paths (relative paths are resolved from the project root)
VECTOR_DB_DIR=data/chroma
DOCS_DIR=documents

# Chunking
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# RAG confidence threshold
RAG_CONFIDENCE_THRESHOLD=0.30